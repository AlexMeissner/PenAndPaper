@using DataTransfer.Initiative
@using DataTransfer.Map
@using System.Threading.Tasks
@using Website.Events
@using Website.Services
@using Website.Services.Graphics
@using Website.Services.Repositories

@rendermode InteractiveServer

@inject ICampaignEventHub CampaignEventHub
@inject IMapRepository MapRepository
@inject IInitiativeRepository InitiativeRepository
@inject IJSRuntime JSRuntime

@implements IDisposable

<div class="initiative-list">
    @foreach (var combatant in _combatants)
    {
        <div class="@GetCombatantClasses(combatant)" style="@GetCombatantStyle(combatant)" @onclick="() => OnCombatantClicked(combatant)" @onmouseup="(args) => OnMouseUp(args, combatant)" @onmouseenter="async () => await OnMouseEnter(combatant)" @onmouseleave="async () => await OnMouseLeave()">
            <img class="image" src="data:image/png;base64,@combatant.Image" />
            @if (IsGameMaster)
            {
                <input type="number" min="1" max="30" class="initiative-input" value=@combatant.Initiative @onchange="(e => OnInitiativeChanged(e, combatant))" />
                <button type="button" class="remove-button" @onclick="() => OnRemove(combatant)" @onclick:stopPropagation="true" @onmouseup:stopPropagation="true">
                    <span class="fa-solid fa-trash"></span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int CampaignId { get; set; }
    [Parameter] public bool IsGameMaster { get; set; }
    [Parameter] public Map? Map { get; set; }

    [Parameter] public EventCallback<Combatant> OnMiddleMouseUp { get; set; }

    private int? _mapId;
    private List<Combatant> _combatants = [];
    private Combatant? _actingCombatant;

    private ICampaignSubscription? combatantAddedSubscription;
    private ICampaignSubscription? combatantRemovedSubscription;
    private ICampaignSubscription? combatantMovedSubscription;
    private ICampaignSubscription? turnChangedSubscription;
    private ICampaignSubscription? mapChangedSubscription;

    public void Dispose()
    {
        combatantAddedSubscription?.Dispose();
        combatantRemovedSubscription?.Dispose();
        combatantMovedSubscription?.Dispose();
        turnChangedSubscription?.Dispose();
        mapChangedSubscription?.Dispose();
    }

    protected override void OnInitialized()
    {
        var campaignDispatcher = CampaignEventHub.ForCampaign(CampaignId);

        combatantAddedSubscription = campaignDispatcher.Subscribe<CombatantAddedEvent>(OnCombatantAdded);
        combatantRemovedSubscription = campaignDispatcher.Subscribe<CombatantRemovedEvent>(OnCombatantRemoved);
        combatantMovedSubscription = campaignDispatcher.Subscribe<CombatantUpdatedEvent>(OnCombatantUpdated);
        turnChangedSubscription = campaignDispatcher.Subscribe<TurnChangedEvent>(OnTurnChanged);
        mapChangedSubscription = campaignDispatcher.Subscribe<MapChangedEvent>(OnMapChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mapId = await MapRepository.GetActiveMapIdAsync(CampaignId);

            if (_mapId is { } mapId)
            {
                _mapId = mapId;
                await UpdateCombatants(mapId);
            }
        }
    }

    private async Task UpdateCombatants(int mapId)
    {
        _combatants = await InitiativeRepository.GetCombatants(mapId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnInitiativeChanged(ChangeEventArgs e, Combatant combatant)
    {
        if (e.Value is string value && uint.Parse(value) is uint initiative && _mapId is { } mapId)
        {
            await InitiativeRepository.UpdateCombatant(CampaignId, mapId, combatant.TokenId, initiative);

            combatant.Initiative = initiative;
            _combatants = _combatants.OrderByDescending(c => c.Initiative).ToList();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnRemove(Combatant combatant)
    {
        try
        {
            if (_mapId is { } mapId)
            {
                await InitiativeRepository.RemoveCombatant(CampaignId, mapId, combatant.TokenId);
            }
        }
        catch (Exception exception)
        {
            await JSRuntime.InvokeVoidAsync("console.error", exception.ToString());
        }
    }

    private async ValueTask OnMapChanged(MapChangedEvent e)
    {
        // Marshal to the Blazor renderer synchronization context to avoid concurrent mutations during render
        await InvokeAsync(async () =>
        {
            _mapId = e.MapId;
            await UpdateCombatants(e.MapId);
        });
    }

    private async ValueTask OnCombatantAdded(CombatantAddedEvent e)
    {
        await InvokeAsync(() =>
        {
            if (e.CharacterId is { } characterId)
            {
                var combatant = new CharacterCombatant
                {
                    TokenId = e.TokenId,
                    Initiative = e.Initiative,
                    Image = e.Image,
                    Color = e.Color,
                    CharacterId = characterId
                };

                _combatants.Add(combatant);
            }
            else if (e.MonsterId is { } monsterId)
            {
                var combatant = new MonsterCombatant
                {
                    TokenId = e.TokenId,
                    Initiative = e.Initiative,
                    Image = e.Image,
                    Color = e.Color,
                    MonsterId = monsterId
                };

                _combatants.Add(combatant);
            }

            _combatants = _combatants.OrderByDescending(c => c.Initiative).ToList();
            StateHasChanged();
        });
    }

    private async ValueTask OnCombatantRemoved(CombatantRemovedEvent e)
    {
        await InvokeAsync(() =>
        {
            if (_combatants.FirstOrDefault(c => c.TokenId == e.TokenId) is Combatant combatant)
            {
                if (_actingCombatant == combatant)
                {
                    _actingCombatant = null;
                }

                _combatants.Remove(combatant);
                StateHasChanged();
            }
        });
    }

    private async ValueTask OnCombatantUpdated(CombatantUpdatedEvent e)
    {
        await InvokeAsync(() =>
        {
            if (_combatants.FirstOrDefault(c => c.TokenId == e.TokenId) is Combatant combatant)
            {
                combatant.Initiative = e.Initiative;
                _combatants = _combatants.OrderByDescending(c => c.Initiative).ToList();
                StateHasChanged();
            }
        });
    }

    private async ValueTask OnTurnChanged(TurnChangedEvent e)
    {
        await InvokeAsync(() =>
        {
            if (_combatants.FirstOrDefault(c => c.TokenId == e.TokenId) is Combatant combatant)
            {
                _actingCombatant = combatant;
                StateHasChanged();
            }
        });
    }

    private async Task OnCombatantClicked(Combatant combatant)
    {
        if (IsGameMaster && _mapId is { } mapId)
        {
            await InitiativeRepository.UpdateTurn(CampaignId, mapId, combatant.TokenId);
        }
    }

    private async Task OnMouseUp(MouseEventArgs args, Combatant combatant)
    {
        if (args.Button == 1) // Middle-mouse button
        {
            await OnMiddleMouseUp.InvokeAsync(combatant);
        }
    }

    private async Task OnMouseEnter(Combatant combatant)
    {
        if (Map is { } map)
        {
            foreach (var token in map.Tokens)
            {
                var alpha = token.Id == combatant.TokenId ? 1.0f : 0.0f;
                await token.SetUniform("isMouseOverInitiative", alpha);
            }
        }
    }

    private async Task OnMouseLeave()
    {
        if (Map is { } map)
        {
            foreach (var token in map.Tokens)
            {
                await token.SetUniform("isMouseOverInitiative", 0.0f);
            }
        }
    }

    private string GetCombatantClasses(Combatant combatant)
    {
        var classes = "combatant";

        if (IsGameMaster)
        {
            classes += " combatant-gamemaster";
        }

        if (combatant == _actingCombatant)
        {
            classes += " acting-combatant";
        }

        return classes;
    }

    private string GetCombatantStyle(Combatant combatant) => $"border-color: {combatant.Color}";
}
